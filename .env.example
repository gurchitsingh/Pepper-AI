# Copy to .env and fill in real values. Never commit the real .env file.

# --- Database / cache ---
DATABASE_URL=postgresql://weave_user:weave_password@localhost:5432/weave_ai_db
REDIS_URL=redis://localhost:6379/0

# --- Auth ---
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=

# --- Transactional email (verification codes) ---
# Set APP_ENV=production to require a real provider; in any other environment,
# if neither is configured, verification codes are logged to the console instead.
APP_ENV=development
EMAIL_FROM="Pepper AI <onboarding@resend.dev>"
# Option A: Resend
RESEND_API_KEY=
# Option B: SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# --- File storage ---
AVATAR_DIR=./uploads/avatars
UPLOAD_DIR=

# --- AI / search providers ---
VOYAGE_API_KEY=
GROQ_API_KEY=
GOOGLE_API_KEY=
TAVILY_API_KEY=
WHISPER_MODEL_SIZE=
